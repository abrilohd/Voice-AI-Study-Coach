# Application Configuration
# Copy this file to .env and fill in the values

# Application Settings
APP_NAME=Voice AI Study Coach
APP_VERSION=0.1.0
DEBUG=True  # Set to True for development

# Database Configuration
# Use postgresql+asyncpg:// for async SQLAlchemy support
# Example: postgresql+asyncpg://username:password@localhost:5432/database_name
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voice_ai_study_coach

# Security Settings
# Generate a secure random string for SECRET_KEY (e.g., openssl rand -hex 32)
SECRET_KEY=
ALGORITHM=HS256  # JWT signing algorithm
ACCESS_TOKEN_EXPIRE_MINUTES=15  # Access token expiration time in minutes
REFRESH_TOKEN_EXPIRE_DAYS=7  # Refresh token expiration time in days

# LLM API Keys
# At least one API key is required for the application to function
ANTHROPIC_API_KEY=  # Claude API key from https://console.anthropic.com/
OPENAI_API_KEY=     # OpenAI API key from https://platform.openai.com/
GEMINI_API_KEY=     # Google Gemini API key from https://makersuite.google.com/

# LLM Configuration
PRIMARY_LLM=claude   # Primary LLM to use: "claude", "openai", or "gemini"
FALLBACK_LLM=openai  # Fallback LLM if primary fails: "claude", "openai", or "gemini"

# CORS Configuration
# JSON array of allowed origins for CORS
# Default allows requests from Vite dev server
CORS_ORIGINS=["http://localhost:5173"]

# RAG Configuration
# Voyage AI API key for embeddings — get from voyageai.com (free tier is generous)
VOYAGE_API_KEY=
